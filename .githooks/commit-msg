#!/usr/bin/env bash
# Enforces Conventional Commits. The release pipeline derives the version from these messages.
set -euo pipefail

[ "${AUTHKIT_SKIP_HOOKS:-0}" = "1" ] && exit 0

message_file="$1"

if [ -x node_modules/.bin/commitlint ]; then
  node_modules/.bin/commitlint --edit "$message_file"
  exit $?
fi

# Before `npm install`, fail only on obviously non-conventional subjects.
subject="$(head -n 1 "$message_file")"

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: use Conventional Commits, for example 'feat(blazor): add phone OTP'."
  echo "commit-msg: run 'npm install && npm run hooks' to enable the full check."
  exit 1
fi
