@inherits AuthKitComponentBase

<AuthKitStyle IncludeStyles="IncludeStyles" />

<div class="ak-form" style="@ThemeVars">
    @if (Logo is not null)
    {
        <img class="ak-logo" src="@Logo" alt="" />
    }

    @if (Error is not null)
    {
        <div class="ak-error" role="alert">@Error.Message</div>
    }

    @if (_mode == ResetMode.Request)
    {
        <form @onsubmit="RequestAsync" @onsubmit:preventDefault>
            <div class="ak-field">
                <label class="ak-label" for="ak-reset-email">@Text(AuthMessageKey.Email)</label>
                <input id="ak-reset-email" class="ak-input" type="email" autocomplete="email"
                       aria-invalid="@(_emailError is not null)"
                       @bind="_email" @bind:event="oninput" />
                @if (_emailError is not null)
                {
                    <span class="ak-hint">@_emailError</span>
                }
            </div>

            @if (_notice is not null)
            {
                <div class="ak-notice" role="status">@_notice</div>
            }

            <button class="ak-button" type="submit" disabled="@Busy">
                @if (Busy)
                {
                    <span class="ak-spinner"></span>
                }
                @Text(AuthMessageKey.SendResetEmail)
            </button>
        </form>
    }
    else
    {
        <form @onsubmit="UpdateAsync" @onsubmit:preventDefault>
            <div class="ak-field">
                <label class="ak-label" for="ak-new-password">@Text(AuthMessageKey.NewPassword)</label>
                <input id="ak-new-password" class="ak-input" type="@(_showPassword ? "text" : "password")"
                       autocomplete="new-password" aria-invalid="@(_passwordError is not null)"
                       @bind="_password" @bind:event="oninput" />
                @if (_passwordError is not null)
                {
                    <span class="ak-hint">@_passwordError</span>
                }
                <button class="ak-link" type="button" @onclick="() => _showPassword = !_showPassword">
                    @Text(_showPassword ? AuthMessageKey.HidePassword : AuthMessageKey.ShowPassword)
                </button>
            </div>

            <div class="ak-field">
                <label class="ak-label" for="ak-new-password-confirm">@Text(AuthMessageKey.ConfirmPassword)</label>
                <input id="ak-new-password-confirm" class="ak-input" type="@(_showPassword ? "text" : "password")"
                       autocomplete="new-password" aria-invalid="@(_confirmError is not null)"
                       @bind="_confirmPassword" @bind:event="oninput" />
                @if (_confirmError is not null)
                {
                    <span class="ak-hint">@_confirmError</span>
                }
            </div>

            @if (_notice is not null)
            {
                <div class="ak-notice" role="status">@_notice</div>
            }

            <button class="ak-button" type="submit" disabled="@Busy">
                @if (Busy)
                {
                    <span class="ak-spinner"></span>
                }
                @Text(AuthMessageKey.UpdatePassword)
            </button>
        </form>
    }
</div>

@code {
    private enum ResetMode
    {
        Request,
        Update
    }

    private ResetMode _mode = ResetMode.Request;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _emailError;
    private string? _passwordError;
    private string? _confirmError;
    private string? _notice;
    private bool _showPassword;

    /// <summary>Raised when the recovery email is sent.</summary>
    [Parameter]
    public EventCallback OnResetRequested { get; set; }

    /// <summary>Raised when the password is changed.</summary>
    [Parameter]
    public EventCallback OnPasswordUpdated { get; set; }

    /// <summary>Overrides <see cref="AuthKitOptions.RedirectTo"/> for this form.</summary>
    [Parameter]
    public string? RedirectTo { get; set; }

    /// <summary>Prefills the email field.</summary>
    [Parameter]
    public string? PrefilledEmail { get; set; }

    /// <summary>
    /// Forces the update form. The recovery link lands with a session, so the caller normally
    /// switches mode when <c>Provider.CurrentSession</c> is not null.
    /// </summary>
    [Parameter]
    public bool UpdateMode { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _email = PrefilledEmail ?? string.Empty;
        _mode = UpdateMode ? ResetMode.Update : ResetMode.Request;
    }

    private async Task RequestAsync()
    {
        _notice = null;
        _emailError = AuthValidation.IsValidEmail(_email) ? null : Text(AuthMessageKey.InvalidEmail);
        if (_emailError is not null)
        {
            return;
        }

        var result = await ExecuteAsync(token =>
            Provider.SendPasswordResetAsync(_email, RedirectTo ?? Options.RedirectTo, token));

        if (result.Ok)
        {
            _notice = Text(AuthMessageKey.ResetEmailSent);
            await OnResetRequested.InvokeAsync();
        }
    }

    private async Task UpdateAsync()
    {
        _notice = null;

        _passwordError = AuthValidation.IsValidPassword(_password, Options.MinimumPasswordLength)
            ? null
            : Text(AuthMessageKey.PasswordTooShort).Replace("{min}", Options.MinimumPasswordLength.ToString(), StringComparison.Ordinal);

        _confirmError = AuthValidation.PasswordsMatch(_password, _confirmPassword)
            ? null
            : Text(AuthMessageKey.PasswordMismatch);

        if (_passwordError is not null || _confirmError is not null)
        {
            return;
        }

        var result = await ExecuteAsync(token => Provider.UpdatePasswordAsync(_password, token));

        if (result.Ok)
        {
            _notice = Text(AuthMessageKey.PasswordUpdated);
            await OnPasswordUpdated.InvokeAsync();
        }
    }
}
